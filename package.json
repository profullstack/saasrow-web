    "@profullstack/autoblog": "^0.4.0",
    "@profullstack/footer": "latest",
    "@profullstack/form-guard": "^0.2.2",
    "@profullstack/redeem-credits": "^0.2.0",
    "@profullstack/referrals": "^0.1.0",
    "@profullstack/stack": "^0.5.0",
    "@profullstack/throttle": "^0.4.0",
    "@profullstack/x402-gateway": "^0.15.2",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "openai": "^7.43.0",
    "posthog-js": "^1.438.23",
    "puppeteer": "^25.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
