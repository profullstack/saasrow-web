{
  "version": "1.0.0",
  "type": "module",
  "name": "anima-project",
  "description": "A Next.js project using Supabase",
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "next lint",
    "test": "bun --bun vitest run",
    "test:ui": "bun --bun vitest --ui",
    "test:coverage": "bun --bun vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun --bun vitest run --exclude '__tests__/api/community.test.ts' --exclude '__tests__/api/newsletter.test.ts' --exclude '__tests__/api/submissions.test.ts'"
  },
  "dependencies": {
    "@netlify/plugin-nextjs": "^5.16.4",
